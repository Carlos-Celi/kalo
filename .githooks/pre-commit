#!/bin/sh
# Bloquea el commit si lo preparado contiene algo con forma de secreto.
# Activación (una vez por clon): git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: falta gitleaks (brew install gitleaks). Commit cancelado." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner
